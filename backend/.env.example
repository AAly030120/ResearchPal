# ── 应用 ──
APP_NAME=ResearchPal
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret

# ── 数据库 ──
# 本地用 SQLite；生产可改为 postgresql://user:pass@host:5432/researchpal
DATABASE_URL=sqlite:///./researchpal.db

# ── CORS（前端地址，逗号分隔；开发可填 *）──
CORS_ORIGINS=*

# ── 文件存储 ──
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MAX_UPLOAD_SIZE=52428800

# ── 默认模型 ──
DEFAULT_MODEL=gpt-4o-mini

# ── 大模型 API Key（至少填一个即可启用真实 AI；全空则进入 Demo 模式）──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
GLM_API_KEY=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
