# ── ResearchPal 后端环境变量示例 ──
# 复制为 backend/.env 后按需修改（.env 已被 .gitignore 忽略，不会提交）

# ── 必填（生产）──
# 生产必须设置强随机密钥，否则启动会拒绝：openssl rand -hex 32
SECRET_KEY=
# 设为 false 即进入生产模式（会强制要求 SECRET_KEY）
DEBUG=false

# ── 数据库 ──
# 留空则用本地 SQLite（开发/演示）。生产（Render 等）设为 Postgres 连接串：
#   postgresql://user:pass@host:5432/dbname
# 注意：本应用会自动把 postgres:// 规范化为 postgresql://
DATABASE_URL=

# ── CORS：前端域名，逗号分隔（开发可填 *）──
CORS_ORIGINS=*

# ── LLM API Key（至少填一个；都不填则进入 Demo 模式）──
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
QWEN_API_KEY=
DEFAULT_MODEL=gpt-4o-mini

# ── RAG 检索增强（可选）──
# 嵌入模型提供方：auto（有 QWEN_API_KEY 用 DashScope，否则本地）/ local / dashscope
EMBEDDING_PROVIDER=auto
# 本地嵌入模型（中文强、~30MB）；英文文献可换 BAAI/bge-small-en-v1.5
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 检索数量与相关性阈值
RAG_TOP_K=15
RAG_TOP_N=6
RAG_MIN_SCORE=0.2
